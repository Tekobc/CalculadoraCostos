# Variables de entorno - Calculadora de Costos

# ----------------------------------------------------------------------
# SUPABASE (Base de datos PostgreSQL, Auth & Row Level Security):
# Obtené tu proyecto gratis en: https://supabase.com/
# ----------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ----------------------------------------------------------------------
# PROVEEDORES DE MODELOS GRATUITOS (Elegí uno de los dos para usar LLM gratis):
# ----------------------------------------------------------------------

# 1. Google Gemini (Recomendado - Gratuito hasta 15 req/min en Google AI Studio):
# Obtené tu clave gratis en: https://aistudio.google.com/
GEMINI_API_KEY=

# 2. Groq (Alternativa gratuita ultrarrápida con Llama 3.3):
# Obtené tu clave gratis en: https://console.groq.com/
GROQ_API_KEY=

# ----------------------------------------------------------------------
# PROVEEDOR PAGO (Opcional):
# ----------------------------------------------------------------------
# Anthropic Claude:
ANTHROPIC_API_KEY=

# ----------------------------------------------------------------------
# NOTA DE FALLBACK OFFLINE:
# Si no configurás ninguna clave, la aplicación funciona al 100% igual
# en modo local utilizando el motor heurístico sin costo alguno.
# ----------------------------------------------------------------------
